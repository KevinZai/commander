{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_description": "Standalone hooks for CC Commander. Use this if you do NOT have ECC installed. All 14 kit-native hooks organized by lifecycle (session-coach retired 2026-07-10 — folded into the plugin's suggest engine). install.sh rewrites $HOME/.claude/hooks/ in each command to the hooks dir of the config it installs into (CLAUDE_CONFIG_DIR aware).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/careful-guard.js\""
          }
        ],
        "description": "Block destructive commands (rm -rf, DROP TABLE, force push, etc.)"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/pre-commit-verify.js\"",
            "timeout": 15
          }
        ],
        "description": "Run TypeScript check before git commit — blocks on tsc errors"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/confidence-gate.js\""
          }
        ],
        "description": "Warn on multi-file bash operations (sed -i on globs, find -exec, etc.)"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/auto-notify.js\""
          }
        ],
        "description": "Auto-notify on significant events"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/preuse-logger.js\""
          }
        ],
        "description": "Log tool usage for analysis"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/context-guard.js\""
          }
        ],
        "description": "Track context usage — warns at ~70% and auto-saves session"
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/auto-checkpoint.js\""
          }
        ],
        "description": "Opt-in (CCC_AUTO_CHECKPOINT=1): every 10 file edits, snapshot tracked changes to refs/ccc-checkpoints/<session>/<n> without touching the worktree, index or stash list; KZ_DISABLE_AUTO_CHECKPOINT=1 turns it off"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/cost-alert.js\""
          }
        ],
        "description": "Cost proxy alerts at ~$0.50 (30 calls) and ~$2.00 (60 calls)"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/auto-lessons.js\""
          }
        ],
        "description": "Auto-capture errors and corrections to tasks/lessons.md"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/rate-predictor.js\""
          }
        ],
        "description": "Predict session duration based on tool call rate"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/pre-compact.js\""
          }
        ],
        "description": "Auto-save session state (cwd, git branch, modified files, active tasks) before context compaction"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/status-checkin.js\""
          }
        ],
        "description": "Session end status check-in"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/session-end-verify.js\""
          }
        ],
        "description": "Verify modified files and check for console.log on session end"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/self-verify.js\""
          }
        ],
        "description": "Check for incomplete tasks, uncommitted changes, and TODO/FIXME in modified files"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v afplay >/dev/null 2>&1 && afplay /System/Library/Sounds/Blow.aiff || true"
          }
        ],
        "description": "Play sound on session completion (macOS)"
      }
    ]
  }
}
