{
  "name": "cc-commander-mcp-cloud",
  "version": "6.5.0",
  "description": "CC Commander hosted MCP server — 72 plugin skills, 22 agents, 23 lifecycle hooks (39 handlers), 2 credential-free bundled MCPs + 16 opt-in, 502+ ecosystem skills",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "node scripts/bundle-catalog.mjs",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/integration.test.ts tests/http.test.ts tests/install-skill.test.ts tests/compatibility-check.test.ts tests/session-diagnose.test.ts tests/compose-plan.test.ts",
    "test:e2e": "node --import tsx --test tests/e2e-smoke.test.ts",
    "test:node": "node --test tests/integration.test.js tests/http.test.js",
    "smoke": "./scripts/smoke-test.sh",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.2",
    "@supabase/supabase-js": "^2.105.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "hono": "^4.12.18",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "posthog-node": "^5.21.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.19",
    "tsx": "^4.22.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
