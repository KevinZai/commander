# CC Commander MCP server — required env vars
# Copy to .env.local for local dev. Production secrets live in Fly.io / 1Password.
#
# ⚠️ Never commit a real .env file. .gitignore already excludes it.

# ── Required: Supabase ───────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Required: Upstash Redis (rate limiting) ─────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ── Required: JWT signing ────────────────────────────────────────────────────
# Must be at least 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=change-me-min-32-chars-for-production

# ── Optional: PostHog analytics ──────────────────────────────────────────────
POSTHOG_API_KEY=

# ── Optional: /metrics bearer-token gate (CWE-306) ──────────────────────────
# If unset, /metrics is publicly readable. Set this in production.
# Generate: openssl rand -hex 32
METRICS_AUTH_TOKEN=

# ── Optional: OAuth 2.1 resource server for /mcp (streamable-HTTP) ──────────
# When unset, /mcp accepts only CC Commander license JWTs (same records as /v1).
# Set the issuer to enable ChatGPT Work's connector OAuth flow. See PAYWALL.md.
OAUTH_ISSUER_URL=
# JWKS override — defaults to ${OAUTH_ISSUER_URL}/.well-known/jwks.json
OAUTH_JWKS_URL=
# Canonical resource id for aud validation + RFC 9728 metadata.
# Production value: https://mcp.commanderplugin.com/mcp
OAUTH_RESOURCE_URL=
# Expected `aud` claim — defaults to OAUTH_RESOURCE_URL
OAUTH_AUDIENCE=

# ── Optional: dark paywall (revenue-opp-2026-07-10 §3+§6) ───────────────────
# Leave UNSET for dark mode (no enforcement change). Set to exactly "1" to arm
# the 100-calls/month free-tier cap. Pro/founders tiers are exempt.
CCC_PAYWALL_ARMED=

# ── Optional: Stripe webhook (tier flips — inert until secret is set) ───────
# Signing secret from the Stripe Dashboard webhook endpoint config.
CCC_STRIPE_WEBHOOK_SECRET=
# Price IDs — created manually in Stripe Dashboard, never by this code.
CCC_STRIPE_PRICE_PRO_MONTHLY=
CCC_STRIPE_PRICE_PRO_YEARLY=
CCC_STRIPE_PRICE_FOUNDERS=
# Only needed if a future change makes real Stripe API calls (not required
# for webhook signature verification).
CCC_STRIPE_API_KEY=

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
