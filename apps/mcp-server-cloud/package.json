{
  "name": "cc-commander-mcp-cloud",
  "version": "4.1.0-beta.2",
  "description": "CC Commander hosted MCP server — 60+ plugin skills, 17 agents, 9 lifecycle hooks (25 handlers), 2 credential-free bundled MCPs + 16 opt-in, 502+ ecosystem skills",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/integration.test.ts tests/http.test.ts tests/install-skill.test.ts tests/compatibility-check.test.ts tests/session-diagnose.test.ts tests/compose-plan.test.ts",
    "test:e2e": "node --import tsx --test tests/e2e-smoke.test.ts",
    "test:node": "node --test tests/integration.test.js tests/http.test.js",
    "smoke": "./scripts/smoke-test.sh",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@supabase/supabase-js": "^4.1.0-beta.2",
    "@upstash/ratelimit": "^4.1.0-beta.2",
    "@upstash/redis": "^4.1.0-beta.2",
    "hono": "^4.1.0-beta.2",
    "jsonwebtoken": "^4.1.0-beta.2",
    "pino": "^4.1.0-beta.2",
    "pino-pretty": "^4.1.0-beta.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^4.1.0-beta.2",
    "@types/node": "^4.1.0-beta.2",
    "tsx": "^4.1.0-beta.2",
    "typescript": "^4.1.0-beta.2"
  },
  "engines": {
    "node": ">=4.1.0-beta.2"
  }
}
