{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site (Next.js landing page)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "site"],
      "port": 3000
    },
    {
      "name": "docs (canonical commanderplugin.com static)",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4000", "--directory", "docs"],
      "port": 4000
    },
    {
      "name": "mcp-server-cloud (Hono dev server)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "apps/mcp-server-cloud"],
      "port": 8080
    },
    {
      "name": "dashboard (vanilla session inspector)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["dashboard/server.js"],
      "port": 4690
    },
    {
      "name": "mintlify-docs (docs.commanderplugin.com preview)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["mintlify", "dev"],
      "port": 3001
    },
    {
      "name": "video (Remotion studio)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "video"],
      "port": 3002
    }
  ]
}
