          "template": "$1${specialist_agents}$2"
        },
        {
          "regex": "({String\\(i\\+1\\)\\.padStart\\(2,'0'\\)}\\/\\d+)",
          "flags": "g",
          "template": "{String(i+1).padStart(2,'0')}/${specialist_agents}"
