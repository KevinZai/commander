{
  "name": "cc-commander-mcp-cloud",
  "version": "6.2.0",
  "description": "CC Commander hosted MCP server — 67 plugin skills, 22 agents, 23 lifecycle hooks (38 handlers), 2 credential-free bundled MCPs + 16 opt-in, 502+ ecosystem skills",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "node scripts/bundle-catalog.mjs",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/integration.test.ts tests/http.test.ts tests/install-skill.test.ts tests/compatibility-check.test.ts tests/session-diagnose.test.ts tests/compose-plan.test.ts",
    "test:e2e": "node --import tsx --test tests/e2e-smoke.test.ts",
    "test:node": "node --test tests/integration.test.js tests/http.test.js",
    "smoke": "./scripts/smoke-test.sh",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@hono/node-server": "^5.0.0",
    "@supabase/supabase-js": "^5.0.0",
    "@upstash/ratelimit": "^5.0.0",
    "@upstash/redis": "^5.0.0",
    "hono": "^5.0.0",
    "jsonwebtoken": "^5.0.0",
    "pino": "^5.0.0",
    "pino-pretty": "^5.0.0",
    "posthog-node": "^5.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^5.0.0",
    "@types/node": "^5.0.0",
    "tsx": "^5.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=5.0.0"
  }
}
