# CC Commander — Local Development Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# All required for full local dev. Some optional (commented).
#
# Placeholders below use REDACTED markers — replace with real values.
# Never push real keys. Use 1Password CLI (op) or platform secret managers.

# ─── Telemetry (PostHog) ────────────────────────────────────────────────────
# Client-side public key — safe to expose, designed for browser
NEXT_PUBLIC_POSTHOG_KEY=phc_REDACTED_PROJECT_CLIENT_KEY_HERE
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side personal API key — DO NOT EXPOSE — used by scripts/refresh-stats.mjs
POSTHOG_PERSONAL_KEY=phx_REDACTED_PERSONAL_MANAGEMENT_KEY_HERE

# ─── Hosted MCP Server (apps/mcp-server-cloud) ──────────────────────────────
# Fly.io deploy token (used by `fly deploy --remote-only`)
FLY_API_TOKEN=REDACTED_FLY_DEPLOY_TOKEN
# PostHog server SDK key (for /v1/events forwarding)
POSTHOG_API_KEY=phc_REDACTED_SERVER_SDK_KEY

# ─── Vercel (docs.commanderplugin.com + commanderplugin.com) ────────────────
# Run `vercel login` interactively; token cached at:
# ~/Library/Application Support/com.vercel.cli/auth.json
VERCEL_PROJECT_ID=prj_REDACTED_PROJECT_ID
VERCEL_TEAM_ID=team_REDACTED_TEAM_ID

# ─── Cloudflare DNS (commanderplugin.com zone) ──────────────────────────────
# Global API Key from 1Password — DO NOT EXPOSE
CF_EMAIL=your-cf-email@example.com
CF_API_KEY=REDACTED_CLOUDFLARE_GLOBAL_KEY
CF_ZONE_ID=REDACTED_ZONE_ID

# ─── Linear (issue tracking) ────────────────────────────────────────────────
LINEAR_API_KEY_PERSONAL=REDACTED_LINEAR_PERSONAL_API_KEY

# ─── GitHub (CI + releases) ─────────────────────────────────────────────────
# Use `gh auth login` instead — token cached in keychain. This is for CI only.
# GITHUB_TOKEN=REDACTED_GITHUB_PERSONAL_ACCESS_TOKEN

# ─── OpenAI / Codex (audit + research agents) ───────────────────────────────
# CODEX uses OAuth — DO NOT SET OPENAI_API_KEY for chat operations.
# OPENAI_API_KEY only used for image generation (DALL-E/gpt-image-1).
# OPENAI_API_KEY=REDACTED_OPENAI_PROJECT_KEY

# ─── Sentry (error tracking) — OPTIONAL ─────────────────────────────────────
# SENTRY_DSN=https://REDACTED@oXXXXX.ingest.sentry.io/XXXXXXX
# SENTRY_AUTH_TOKEN=REDACTED_SENTRY_AUTH_TOKEN

# ─── Stripe (Pro tier billing — NOT YET ACTIVE) ─────────────────────────────
# STRIPE_SECRET_KEY=REDACTED_STRIPE_SECRET
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=REDACTED_STRIPE_PUBLISHABLE
# STRIPE_WEBHOOK_SECRET=REDACTED_STRIPE_WEBHOOK_SECRET

# ─── Telemetry Opt-Out ──────────────────────────────────────────────────────
# Set to "0" to disable all CC Commander telemetry
# CCC_TELEMETRY=1
# CCC_TELEMETRY_DEBUG=0
