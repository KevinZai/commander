{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CODEX_PLUGIN_ROOT}/hooks/orchestrator/session-start-orchestrator.js",
            "timeout": 15000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CODEX_PLUGIN_ROOT}/hooks/suggest-ticker.js",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "node ${CODEX_PLUGIN_ROOT}/hooks/intent-classifier.js",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node ${CODEX_PLUGIN_ROOT}/hooks/context-warning.js",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "node ${CODEX_PLUGIN_ROOT}/hooks/context-guard.js",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "node ${CODEX_PLUGIN_ROOT}/hooks/user-prompt-submit.js",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CODEX_PLUGIN_ROOT}/hooks/cost-tracker.js",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "node ${CODEX_PLUGIN_ROOT}/hooks/cost-ceiling-enforcer.js",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "node ${CODEX_PLUGIN_ROOT}/hooks/secret-leak-guard.js",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CODEX_PLUGIN_ROOT}/hooks/knowledge-capture.js",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CODEX_PLUGIN_ROOT}/hooks/session-save.js",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "node ${CODEX_PLUGIN_ROOT}/hooks/session-end.js",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "node ${CODEX_PLUGIN_ROOT}/hooks/suggest-lightweight.js",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "node ${CODEX_PLUGIN_ROOT}/hooks/clickability-watch.js",
            "timeout": 1500
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CODEX_PLUGIN_ROOT}/hooks/permission-gate.js",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
