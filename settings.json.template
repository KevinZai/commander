{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "\"$HOME/.claude/lib/statusline.sh\"",
    "padding": 1
  },
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "NODE_OPTIONS": "--max-old-space-size=4096"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Skill(*)",
      "Bash(git status:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)"
    ],
    "defaultMode": "auto"
  },
  "extraKnownMarketplaces": {
    "commander-hub": {
      "source": {
        "source": "git",
        "url": "https://github.com/kevinzai/commander.git"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.claude/hooks/careful-guard.js\" ]; then node \"$HOME/.claude/hooks/careful-guard.js\"; fi"
          },
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.claude/hooks/confidence-gate.js\" ]; then node \"$HOME/.claude/hooks/confidence-gate.js\"; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v afplay >/dev/null 2>&1 && afplay \"/System/Library/Sounds/Blow.aiff\" || true"
          }
        ]
      }
    ]
  }
}
