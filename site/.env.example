# CC Commander Site — environment variables
# Copy to .env.local and fill in values.
# All vars are optional in dev — pages fail-open with "coming soon" copy.

# ── Stripe (legacy — being replaced by Lemon Squeezy per CC-663) ──────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_TEAM_MONTHLY=price_...
STRIPE_PRICE_TEAM_YEARLY=price_...

# ── Lemon Squeezy (CC-664) ────────────────────────────────────────────────────
# Create account at lemonsqueezy.com, then generate API key in Settings → API
LEMONSQUEEZY_API_KEY=
# The LS-hosted affiliate signup page URL (found in your LS store → Affiliates)
LEMONSQUEEZY_AFFILIATE_SIGNUP_URL=

# ── Auth.js v5 (CC-665) ───────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=
# GitHub OAuth App — create at github.com/settings/applications/new
# Callback URL: https://commanderplugin.com/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ── Supabase (CC-665 D) ───────────────────────────────────────────────────────
# Required for creators table, creator_clicks, creator_conversions
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Site config ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://commanderplugin.com
